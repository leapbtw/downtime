{
  "schemaVersion": 1,
  "id": "downtime",
  "version": "${version}",
  "name": "downtime",
  "description": "Promemoria per le pause: timer di gioco, avviso, grayscale e quiz matematico.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "leapbtw.downtime.client.DowntimeDataGenerator"
    ],
    "client": [
      "leapbtw.downtime.client.DowntimeClient"
    ],
    "main": [
      "leapbtw.downtime.Downtime"
    ]
  },
  "mixins": [
    "downtime.mixins.json",
    {
      "config": "downtime.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
